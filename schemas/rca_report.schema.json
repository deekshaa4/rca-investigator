{
  "$defs": {
    "Action": {
      "properties": {
        "action": {
          "minLength": 1,
          "title": "Action",
          "type": "string"
        },
        "type": {
          "$ref": "#/$defs/ActionType"
        },
        "priority": {
          "$ref": "#/$defs/Priority"
        },
        "addresses_factors": {
          "description": "Ranks of the contributing factors this action addresses",
          "items": {
            "type": "integer"
          },
          "title": "Addresses Factors",
          "type": "array"
        }
      },
      "required": [
        "action",
        "type",
        "priority"
      ],
      "title": "Action",
      "type": "object"
    },
    "ActionType": {
      "enum": [
        "corrective",
        "preventive"
      ],
      "title": "ActionType",
      "type": "string"
    },
    "ChangeSummary": {
      "properties": {
        "metric": {
          "title": "Metric",
          "type": "string"
        },
        "segment": {
          "additionalProperties": {
            "type": "string"
          },
          "description": "Where the change is concentrated, e.g. {'service': 'checkout'}",
          "title": "Segment",
          "type": "object"
        },
        "change_start": {
          "description": "ISO 8601 time the change began",
          "title": "Change Start",
          "type": "string"
        },
        "baseline_value": {
          "title": "Baseline Value",
          "type": "number"
        },
        "current_value": {
          "title": "Current Value",
          "type": "number"
        },
        "relative_change": {
          "description": "(current - baseline) / baseline",
          "title": "Relative Change",
          "type": "number"
        },
        "evidence_ids": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Evidence Ids",
          "type": "array"
        }
      },
      "required": [
        "metric",
        "change_start",
        "baseline_value",
        "current_value",
        "relative_change",
        "evidence_ids"
      ],
      "title": "ChangeSummary",
      "type": "object"
    },
    "ContributingFactor": {
      "properties": {
        "rank": {
          "minimum": 1,
          "title": "Rank",
          "type": "integer"
        },
        "description": {
          "minLength": 1,
          "title": "Description",
          "type": "string"
        },
        "category": {
          "$ref": "#/$defs/FactorCategory"
        },
        "confidence": {
          "maximum": 1,
          "minimum": 0,
          "title": "Confidence",
          "type": "number"
        },
        "why_chain": {
          "description": "'5 Whys' chain from symptom to root cause",
          "items": {
            "type": "string"
          },
          "title": "Why Chain",
          "type": "array"
        },
        "evidence_ids": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Evidence Ids",
          "type": "array"
        }
      },
      "required": [
        "rank",
        "description",
        "category",
        "confidence",
        "evidence_ids"
      ],
      "title": "ContributingFactor",
      "type": "object"
    },
    "Evidence": {
      "properties": {
        "id": {
          "description": "Evidence ID, e.g. 'E1'",
          "pattern": "^E\\d+$",
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/EvidenceKind"
        },
        "source": {
          "description": "Where it came from, e.g. 'metrics:error_rate' or 'deploys'",
          "title": "Source",
          "type": "string"
        },
        "summary": {
          "minLength": 1,
          "title": "Summary",
          "type": "string"
        },
        "timestamp": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "ISO 8601 time, if known",
          "title": "Timestamp"
        }
      },
      "required": [
        "id",
        "kind",
        "source",
        "summary"
      ],
      "title": "Evidence",
      "type": "object"
    },
    "EvidenceKind": {
      "enum": [
        "metric",
        "record",
        "document"
      ],
      "title": "EvidenceKind",
      "type": "string"
    },
    "FactorCategory": {
      "enum": [
        "deployment",
        "config_change",
        "traffic",
        "dependency",
        "infrastructure",
        "data",
        "unknown"
      ],
      "title": "FactorCategory",
      "type": "string"
    },
    "Guardrails": {
      "description": "What the fact-checker removed from the model's answer.",
      "properties": {
        "model_used": {
          "description": "Whether a language model wrote the factors",
          "title": "Model Used",
          "type": "boolean"
        },
        "ids_cited": {
          "default": 0,
          "description": "Evidence IDs the model cited",
          "minimum": 0,
          "title": "Ids Cited",
          "type": "integer"
        },
        "ids_invented": {
          "default": 0,
          "description": "Cited IDs that do not exist",
          "minimum": 0,
          "title": "Ids Invented",
          "type": "integer"
        },
        "factors_dropped": {
          "default": 0,
          "description": "Factors removed (no real evidence, or symptoms only)",
          "minimum": 0,
          "title": "Factors Dropped",
          "type": "integer"
        },
        "engine_fallback": {
          "default": false,
          "description": "The main factor came from the engines, not the model",
          "title": "Engine Fallback",
          "type": "boolean"
        },
        "quotes_checked": {
          "default": 0,
          "description": "Document quotes checked",
          "minimum": 0,
          "title": "Quotes Checked",
          "type": "integer"
        },
        "quotes_rejected": {
          "default": 0,
          "description": "Quotes not found word for word in the document (removed)",
          "minimum": 0,
          "title": "Quotes Rejected",
          "type": "integer"
        },
        "charts_found": {
          "default": 0,
          "description": "Charts found in the documents",
          "minimum": 0,
          "title": "Charts Found",
          "type": "integer"
        },
        "charts_read": {
          "default": 0,
          "description": "Charts looked at by a vision model",
          "minimum": 0,
          "title": "Charts Read",
          "type": "integer"
        },
        "engine_override": {
          "default": false,
          "description": "A model factor resting on a change that is too early or in another place was replaced by the engines' candidate",
          "title": "Engine Override",
          "type": "boolean"
        },
        "rivals_added": {
          "default": 0,
          "description": "Competing changes added so that every equally good candidate is named",
          "minimum": 0,
          "title": "Rivals Added",
          "type": "integer"
        }
      },
      "required": [
        "model_used"
      ],
      "title": "Guardrails",
      "type": "object"
    },
    "Priority": {
      "enum": [
        "high",
        "medium",
        "low"
      ],
      "title": "Priority",
      "type": "string"
    },
    "RuledOutHypothesis": {
      "properties": {
        "hypothesis": {
          "title": "Hypothesis",
          "type": "string"
        },
        "reason": {
          "title": "Reason",
          "type": "string"
        },
        "evidence_ids": {
          "items": {
            "type": "string"
          },
          "title": "Evidence Ids",
          "type": "array"
        }
      },
      "required": [
        "hypothesis",
        "reason"
      ],
      "title": "RuledOutHypothesis",
      "type": "object"
    },
    "Sufficiency": {
      "properties": {
        "verdict": {
          "$ref": "#/$defs/Verdict"
        },
        "score": {
          "maximum": 1,
          "minimum": 0,
          "title": "Score",
          "type": "number"
        },
        "reasons": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Reasons",
          "type": "array"
        },
        "missing_data": {
          "description": "Data that would make the conclusion more reliable",
          "items": {
            "type": "string"
          },
          "title": "Missing Data",
          "type": "array"
        }
      },
      "required": [
        "verdict",
        "score",
        "reasons"
      ],
      "title": "Sufficiency",
      "type": "object"
    },
    "Verdict": {
      "enum": [
        "sufficient",
        "partial",
        "insufficient"
      ],
      "title": "Verdict",
      "type": "string"
    }
  },
  "properties": {
    "incident_id": {
      "title": "Incident Id",
      "type": "string"
    },
    "question": {
      "title": "Question",
      "type": "string"
    },
    "what_changed": {
      "anyOf": [
        {
          "$ref": "#/$defs/ChangeSummary"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "summary": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Summary"
    },
    "contributing_factors": {
      "items": {
        "$ref": "#/$defs/ContributingFactor"
      },
      "title": "Contributing Factors",
      "type": "array"
    },
    "ruled_out": {
      "items": {
        "$ref": "#/$defs/RuledOutHypothesis"
      },
      "title": "Ruled Out",
      "type": "array"
    },
    "evidence": {
      "items": {
        "$ref": "#/$defs/Evidence"
      },
      "minItems": 1,
      "title": "Evidence",
      "type": "array"
    },
    "sufficiency": {
      "$ref": "#/$defs/Sufficiency"
    },
    "actions": {
      "items": {
        "$ref": "#/$defs/Action"
      },
      "title": "Actions",
      "type": "array"
    },
    "guardrails": {
      "anyOf": [
        {
          "$ref": "#/$defs/Guardrails"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "required": [
    "incident_id",
    "question",
    "contributing_factors",
    "evidence",
    "sufficiency"
  ],
  "title": "RCAReport",
  "type": "object"
}
